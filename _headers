# Response headers for Cloudflare Pages / Workers static assets (see DEPLOY-NOTES.md).
# Rules add up, so Cache-Control is only ever set by ONE rule per path.
# HTML keeps Cloudflare's default (public, max-age=0, must-revalidate = always re-checked).

/*
  Strict-Transport-Security: max-age=86400
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' https://cdn.fontshare.com https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self'; connect-src 'self' https://api.pulsinglabs.com https://cloudflareinsights.com; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# CSS and JS are referenced with ?v=N and the number is bumped on every change,
# so a year-long immutable cache is safe.
/assets/app.js
  Cache-Control: public, max-age=31536000, immutable
/assets/style.css
  Cache-Control: public, max-age=31536000, immutable
/assets/compare.css
  Cache-Control: public, max-age=31536000, immutable
/assets/compare.js
  Cache-Control: public, max-age=31536000, immutable

# Images and the AI demo videos (not versioned): one week.
/assets/img/*
  Cache-Control: public, max-age=604800

# 3D model and the pinned self-hosted engines: 30 days.
/assets/models/*
  Cache-Control: public, max-age=2592000
/assets/vendor/*
  Cache-Control: public, max-age=2592000
